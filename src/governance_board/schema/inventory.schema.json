{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governance-board/inventory.schema.json",
  "title": "AgentInventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_max_age_days", "organization", "agents"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "review_max_age_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "organization": { "type": "string", "minLength": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "backup_owner",
        "version",
        "model",
        "provider",
        "purpose",
        "data_classes",
        "risk_tier",
        "approval_gates",
        "budget",
        "slo",
        "status",
        "kill_switch",
        "last_review",
        "eval_evidence",
        "prompt_id",
        "prompt_version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "backup_owner": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "data_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_tier": { "type": "string", "enum": ["low", "medium", "high"] },
        "approval_gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "budget": { "$ref": "#/$defs/budget" },
        "slo": { "$ref": "#/$defs/slo" },
        "status": { "type": "string", "enum": ["active", "disabled", "shadow"] },
        "kill_switch": { "type": "string", "enum": ["engaged", "disengaged"] },
        "last_review": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "eval_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "enforced_at", "effects_covered"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["human", "none"] },
        "required": { "type": "boolean" },
        "enforced_at": {
          "type": "string",
          "enum": ["runtime_effect_check", "human_queue", "not_applicable"]
        },
        "effects_covered": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_run_micro_usd", "per_day_micro_usd"],
      "properties": {
        "per_run_micro_usd": { "type": "integer", "minimum": 0 },
        "per_day_micro_usd": { "type": "integer", "minimum": 0 }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95_latency_ms", "cost_per_run_micro_usd"],
      "properties": {
        "p95_latency_ms": { "type": "integer", "minimum": 1 },
        "cost_per_run_micro_usd": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
